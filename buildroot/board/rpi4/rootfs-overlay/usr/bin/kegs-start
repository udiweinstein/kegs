#!/bin/sh
# Started by init on tty1 (see /etc/inittab).  Runs KEGS full screen on
# the HDMI display, with its files on the KEGS partition (/kegs).

AUDIO=vc4hdmi0
KEGS_ARGS=

# Optional settings from /kegs/kegs.env (KEY=value lines, may have CRLF)
if [ -f /kegs/kegs.env ]; then
	while IFS='=' read -r key val; do
		val=$(printf '%s' "$val" | tr -d '\r')
		case "$key" in
		AUDIO)		AUDIO=$val ;;
		KEGS_ARGS)	KEGS_ARGS=$val ;;
		SDL_*)		export "$key=$val" ;;
		esac
	done < /kegs/kegs.env
fi

# ALSA: send sound to the chosen card (vc4hdmi0 = HDMI, Headphones = jack)
export HOME=/tmp/kegs-home
mkdir -p "$HOME"
printf 'defaults.pcm.card %s\ndefaults.ctl.card %s\n' "$AUDIO" "$AUDIO" \
	> "$HOME/.asoundrc"

export SDL_VIDEODRIVER=kmsdrm
export SDL_AUDIODRIVER=alsa

# Nothing is shown on the screen except a missing ROM; problems go to
#  the logs (kegs.log / boot-log.txt on the KEGS partition)
if ! mountpoint -q /kegs; then
	echo "KEGS partition (/kegs) is not mounted" > /tmp/kegs-start.log
	sleep 10
	exit 1
fi
cd /kegs || exit 1

# No ROM file yet: say so on the screen instead of a black screen
HAVE_ROM=0
for f in /kegs/ROM* /kegs/rom* /kegs/Rom* /kegs/*.rom /kegs/*.ROM; do
	[ -f "$f" ] && HAVE_ROM=1
done
if [ "$HAVE_ROM" = 0 ]; then
	echo
	echo "  No IIgs ROM file on the KEGS partition."
	echo "  Put the SD card in a Mac or PC and copy your ROM file to the"
	echo "  KEGS drive, named ROM (or ROM.01 / ROM.03).  Then restart."
	sleep 60
	exit 1
fi

# Logs on the KEGS partition, so they can be read on a Mac or PC
# (written in the background, so KEGS starts without waiting)
LOG=/kegs/kegs.log
(
	sleep 5
	{
		echo "=== $(date)  KEGS_ARGS=$KEGS_ARGS AUDIO=$AUDIO"
		ls -l /dev/dri /kegs 2>&1
		cat /sys/class/drm/card*-HDMI*/status 2>/dev/null
		dmesg
	} > /kegs/boot-log.txt 2>&1
	sync
) &

# KEGS saves its start-up screen here; S00kegs-splash shows it at boot
export KEGS_SPLASH=/kegs/.kegs-splash

START=$(date +%s)
# shellcheck disable=SC2086
/usr/bin/sdlkegs $KEGS_ARGS > "$LOG" 2>&1
RC=$?
echo "=== KEGS exited with code $RC" >> "$LOG"
sync

# Stopped right away: wait a little before init starts it again
if [ $(( $(date +%s) - START )) -lt 15 ]; then
	sleep 10
fi
